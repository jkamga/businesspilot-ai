# =========================================================
# BusinessPilot AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git
# =========================================================

# Base de données
DB_NAME=businesspilot
DB_USERNAME=businesspilot
DB_PASSWORD=change_me_local_only
DB_PORT=5432

# Backend
SERVER_PORT=8080
SPRING_PROFILE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT (générer avec : openssl rand -base64 64)
JWT_SECRET=change_me_minimum_256_bits_long_secret_key_generate_with_openssl
JWT_EXPIRY_MS=86400000
JWT_REFRESH_EXPIRY_MS=604800000

# IA — Fournisseur LLM
AI_PROVIDER_API_KEY=your_api_key_here
AI_PROVIDER_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=2048

# Ports exposés
BACKEND_PORT=8080
FRONTEND_PORT=4200
NGINX_PORT=80
